{
  "name": "@ascend/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ASCEND desktop app: Electron shell + React renderer",
  "license": "MIT",
  "author": "The ASCEND team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/rajdhani": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-muscle-highlighter": "1.2.0"
  },
  "devDependencies": {
    "@ascend/shared": "0.1.0",
    "@eslint/js": "^9.12.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "wait-on": "^8.0.1"
  }
}
