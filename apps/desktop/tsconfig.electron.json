{
  // Electron main + preload: compiled to CommonJS in dist-electron/ (Electron loads it directly).
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    // TypeScript 6 deprecates node10 resolution; it still works and emits the same CommonJS.
    // Moving to Node16 means ESM-style imports in packages/shared, so it is a separate change.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "rootDir": "electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron"],
  // Tests run under Vitest (type-checked with tsconfig.json), never shipped.
  "exclude": ["electron/**/*.test.ts"]
}
