{
  "name": "ascend",
  "private": true,
  "version": "0.3.0",
  "description": "ASCEND: an offline desktop fitness RPG (Electron + React + FastAPI sidecar)",
  "license": "MIT",
  "workspaces": [
    "apps/desktop",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
