{
 "version": 1,
 "scale": {
  "primary": 1.0,
  "secondary": 0.5
 },
 "floor": 0.2,
 "combine": "max",
 "zero_load": {
  "categories": [
   "stretching"
  ],
  "name_regex": "smr|stretch|foam roll"
 },
 "region_rules": {
  "chest": [
   {
    "id": "C1-fly-incline",
    "regex": "(incline|low[- ]?cable|low[- ]?pulley|upward).*(fly|flye|crossover)|(fly|flye|crossover).*(incline|low)",
    "weights": {
     "pec_major_clavicular": 1.0,
     "pec_major_sternal": 0.5,
     "deltoid_anterior": 0.25,
     "biceps_short": 0.25
    },
    "source": "E"
   },
   {
    "id": "C2-fly",
    "regex": "\\b(fly|flye|flyes|flys|crossover|pec deck|butterfly)\\b",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.75,
     "deltoid_anterior": 0.25,
     "biceps_short": 0.25
    },
    "source": "Campos2020,Solstad2020"
   },
   {
    "id": "C3-pullover",
    "regex": "pullover",
    "weights": {
     "pec_major_sternal": 1.0,
     "latissimus_dorsi": 0.5,
     "teres_major": 0.5,
     "triceps_long": 0.5,
     "serratus_anterior": 0.25
    },
    "source": "Marchetti2011,DiFonza2026"
   },
   {
    "id": "C4-dip",
    "regex": "\\bdips?\\b",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.25,
     "pec_minor": 0.5,
     "deltoid_anterior": 0.5
    },
    "source": "E"
   },
   {
    "id": "C5-pushup-plus",
    "regex": "push[- ]?up plus|scap(ular)? push",
    "weights": {
     "serratus_anterior": 1.0,
     "pec_major_sternal": 0.5
    },
    "source": "Ludewig2004"
   },
   {
    "id": "C6-pushup-incline",
    "regex": "incline push[- ]?up",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.25,
     "deltoid_anterior": 0.5,
     "serratus_anterior": 0.5
    },
    "source": "E"
   },
   {
    "id": "C7-pushup-decline",
    "regex": "decline push[- ]?up|feet elevated|pike",
    "weights": {
     "pec_major_clavicular": 1.0,
     "pec_major_sternal": 0.75,
     "deltoid_anterior": 0.75,
     "serratus_anterior": 0.5
    },
    "source": "E"
   },
   {
    "id": "C8-pushup",
    "regex": "push[- ]?ups?\\b|pushups?\\b|press[- ]?up",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.5,
     "deltoid_anterior": 0.5,
     "serratus_anterior": 0.5,
     "triceps_lateral": 0.5,
     "triceps_medial": 0.5
    },
    "source": "Marcolin2015,Ludewig2004"
   },
   {
    "id": "C9-incline",
    "regex": "incline",
    "weights": {
     "pec_major_clavicular": 1.0,
     "pec_major_sternal": 0.5,
     "deltoid_anterior": 0.75
    },
    "source": "RodriguezRidao2020,Chaves2020"
   },
   {
    "id": "C10-decline",
    "regex": "decline",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.25
    },
    "source": "RodriguezRidao2020(intro),GlassArmstrong1997[snippet]"
   },
   {
    "id": "C11-closegrip",
    "regex": "close[- ]?grip|narrow[- ]?grip",
    "weights": {
     "pec_major_sternal": 0.75,
     "pec_major_clavicular": 0.5,
     "deltoid_anterior": 0.5
    },
    "source": "Saeterbakken2021"
   },
   {
    "id": "C0-default",
    "regex": "",
    "weights": {
     "pec_major_sternal": 1.0,
     "pec_major_clavicular": 0.75,
     "pec_minor": 0.25
    },
    "source": "RodriguezRidao2020"
   }
  ],
  "shoulders": [
   {
    "id": "S1-ext-rot",
    "regex": "external rotation|\\bexternal rot",
    "weights": {
     "infraspinatus": 1.0,
     "teres_minor": 1.0,
     "deltoid_posterior": 0.5
    },
    "source": "Reinold2004"
   },
   {
    "id": "S2-int-rot",
    "regex": "internal rotation",
    "weights": {
     "subscapularis": 1.0,
     "pec_major_sternal": 0.25,
     "teres_major": 0.25
    },
    "source": "Decker2003,E"
   },
   {
    "id": "S3-rear",
    "regex": "rear|reverse.*fl[iy]|face pull|bent[- ]?over.*(raise|lateral|fly)|prone.*(raise|fly)|(raise|fly).*bent[- ]?over|lying rear|back fly|posterior",
    "weights": {
     "deltoid_posterior": 1.0,
     "infraspinatus": 0.5,
     "teres_minor": 0.5,
     "trap_middle": 0.5,
     "rhomboids": 0.5,
     "deltoid_lateral": 0.25
    },
    "source": "Schoenfeld2013,Reinold2004"
   },
   {
    "id": "S11-chest-press",
    "regex": "bench|chest press|floor press|push[- ]?ups?|pushups?|\\bdips?\\b|\\bfly|flye|crossover|pec deck|guillotine",
    "weights": {
     "deltoid_anterior": 1.0
    },
    "source": "Campos2020,RodriguezRidao2020"
   },
   {
    "id": "S4-upright",
    "regex": "upright|high pull",
    "weights": {
     "deltoid_lateral": 1.0,
     "trap_upper": 0.75,
     "deltoid_anterior": 0.5,
     "biceps_long": 0.25,
     "biceps_short": 0.25
    },
    "source": "E"
   },
   {
    "id": "S10-pull",
    "regex": "\\brows?\\b|pull[- ]?downs?|pull[- ]?ups?|\\bchin|face pull|pullover",
    "weights": {
     "deltoid_posterior": 1.0,
     "infraspinatus": 0.5,
     "teres_minor": 0.5
    },
    "source": "Reinold2004,Youdas2010,E"
   },
   {
    "id": "S5-lateral",
    "regex": "lateral raise|side raise|side lateral|\\blateral\\b|\\bside\\b|iron cross",
    "weights": {
     "deltoid_lateral": 1.0,
     "deltoid_anterior": 0.5,
     "deltoid_posterior": 0.5,
     "supraspinatus": 0.5,
     "trap_upper": 0.5
    },
    "source": "Campos2020,Coratella2020,Reinold2007"
   },
   {
    "id": "S6-front-raise",
    "regex": "front raise|front .*raise|front plate|frontal raise",
    "weights": {
     "deltoid_anterior": 1.0,
     "pec_major_clavicular": 0.5,
     "deltoid_lateral": 0.25
    },
    "source": "Coratella2020"
   },
   {
    "id": "S7-behind-neck",
    "regex": "behind (the )?neck|back press",
    "weights": {
     "deltoid_anterior": 1.0,
     "deltoid_lateral": 0.75,
     "deltoid_posterior": 0.5,
     "trap_upper": 0.25,
     "supraspinatus": 0.25
    },
    "source": "Coratella2022"
   },
   {
    "id": "S8-arnold",
    "regex": "arnold",
    "weights": {
     "deltoid_anterior": 1.0,
     "deltoid_lateral": 0.75,
     "trap_upper": 0.25,
     "supraspinatus": 0.25
    },
    "source": "E"
   },
   {
    "id": "S9-olympic",
    "regex": "clean|snatch|jerk",
    "weights": {
     "deltoid_anterior": 0.75,
     "deltoid_lateral": 0.5,
     "trap_upper": 0.75
    },
    "source": "E"
   },
   {
    "id": "S0-default",
    "regex": "",
    "weights": {
     "deltoid_anterior": 1.0,
     "deltoid_lateral": 0.5,
     "deltoid_posterior": 0.25,
     "trap_upper": 0.25,
     "supraspinatus": 0.25
    },
    "source": "Campos2020,Coratella2022"
   }
  ],
  "triceps": [
   {
    "id": "T1-overhead",
    "regex": "overhead|french|over ?head|above head|seated triceps press|standing .*triceps (press|extension)|tate|behind the head",
