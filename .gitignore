# --- Node / Electron ---
node_modules/
dist/
dist-electron/
release/
*.tsbuildinfo
.vite/
coverage/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# PyInstaller's work folder. Anchored on purpose: apps/desktop/build/ holds tracked build
# resources (fuses.cjs, icons) that electron-builder needs.
/services/sidecar/build/
*.spec.bak
htmlcov/
.coverage

# --- Local data (never commit user data) ---
*.db
*.db-wal
*.db-shm
data/
*.ascendbak

# --- ML artefacts (tracked by DVC, not git) ---
ml/data/raw/
ml/data/processed/
ml/models/*.onnx
ml/models/*.pt
ml/models/models-manifest.json
ml/reports/
ml/metrics.json
mlruns/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.env
.env.*
!.env.example
